{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs691.local/contracts/itinerary.schema.json",
  "title": "Itinerary",
  "description": "The output of the optimizer: a day-by-day schedule. Any component may be replaced as long as it still speaks this shape. One of the three team contracts.",
  "type": "object",
  "required": ["trip_id", "destination", "start_date", "end_date", "days", "totals"],
  "additionalProperties": false,
  "properties": {
    "trip_id": { "type": "string", "minLength": 1 },
    "destination": {
      "type": "object",
      "required": ["name", "lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "country": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "days": {
      "type": "array",
      "items": { "$ref": "#/$defs/day" }
    },
    "totals": {
      "type": "object",
      "required": ["cost", "currency", "walking_minutes"],
      "additionalProperties": false,
      "properties": {
        "cost": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "walking_minutes": { "type": "number", "minimum": 0 }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" }, "default": [] },
    "score": { "type": "number", "description": "Overall itinerary quality 0..1." }
  },
  "$defs": {
    "confidence": { "type": "string", "enum": ["known", "inferred", "unknown"] },
    "item": {
      "type": "object",
      "required": ["place_id", "start", "end", "cost", "reason", "confidence"],
      "additionalProperties": false,
      "properties": {
        "place_id": { "type": "string", "minLength": 1 },
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "travel_from_prev": {
          "type": "object",
          "required": ["minutes", "mode"],
          "additionalProperties": false,
          "properties": {
            "minutes": { "type": "number", "minimum": 0 },
            "mode": { "type": "string", "enum": ["walk", "transit", "drive", "none"] }
          }
        },
        "cost": { "type": "number", "minimum": 0 },
        "reason": { "type": "string" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "day": {
      "type": "object",
      "required": ["date", "items"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "format": "date" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    }
  }
}
