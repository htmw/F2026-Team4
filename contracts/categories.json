    "gallery": ["art"],
    "monument": ["history", "architecture"],
    "landmark": ["history", "architecture"],
    "church": ["history", "architecture"],
    "castle": ["history", "architecture"],
    "palace": ["history", "architecture"],
    "viewpoint": ["nature", "architecture"],
    "park": ["nature"],
    "garden": ["nature"],
    "beach": ["nature"],
    "restaurant": ["food"],
    "cafe": ["food"],
    "bakery": ["food"],
    "market": ["food", "shopping"],
    "bar": ["nightlife"],
    "nightclub": ["nightlife"],
