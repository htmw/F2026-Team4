{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs691.local/contracts/place.schema.json",
  "title": "Place",
  "description": "A single point of interest. This is one of the three shapes the whole team codes against. Do not add fields without team agreement.",
  "type": "object",
  "required": ["id", "name", "lat", "lon", "categories", "typical_duration_minutes", "cost", "hours", "source"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable id, e.g. 'osm:node/123456'.",
      "minLength": 1
    },
    "name": { "type": "string", "minLength": 1 },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "categories": {
      "type": "array",
      "description": "Free-form tags drawn from the controlled vocabulary in categories.json.",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "typical_duration_minutes": {
      "type": "integer",
      "description": "How long a visitor typically spends here.",
      "minimum": 5,
      "maximum": 1440
    },
    "cost": { "$ref": "#/$defs/cost" },
    "hours": { "$ref": "#/$defs/hours" },
    "rating": { "type": "number", "minimum": 0, "maximum": 5 },
    "popularity": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": {
      "type": "string",
      "description": "Where this record came from, e.g. 'osm', 'fixture'."
    },
    "last_verified": {
      "type": "string",
      "description": "ISO date (YYYY-MM-DD) the data was last checked.",
      "format": "date"
    }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "description": "known = from real data; inferred = category default; unknown = no idea.",
      "enum": ["known", "inferred", "unknown"]
    },
    "cost": {
      "type": "object",
      "required": ["amount", "currency", "confidence"],
      "additionalProperties": false,
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "timepair": {
      "type": "array",
      "description": "An [open, close] pair as 24h HH:MM strings.",
      "items": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
      "minItems": 2,
      "maxItems": 2
    },
    "dayhours": {
      "description": "null means closed that day; otherwise a list of [open, close] pairs (supports split lunch/dinner service).",
      "oneOf": [
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/timepair" }, "minItems": 1 }
      ]
    },
    "hours": {
      "type": "object",
      "required": ["mon", "tue", "wed", "thu", "fri", "sat", "sun", "confidence"],
      "additionalProperties": false,
      "properties": {
        "mon": { "$ref": "#/$defs/dayhours" },
        "tue": { "$ref": "#/$defs/dayhours" },
        "wed": { "$ref": "#/$defs/dayhours" },
        "thu": { "$ref": "#/$defs/dayhours" },
        "fri": { "$ref": "#/$defs/dayhours" },
        "sat": { "$ref": "#/$defs/dayhours" },
        "sun": { "$ref": "#/$defs/dayhours" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    }
  }
}
